 from __future__ import annotations

-from auth.token import should_retry_rotation
+import time
+
+import pytest
+
+from auth.token import TokenRotationError, rotate_token, should_retry_rotation


 def test_timeout_errors_are_retryable() -> None:
@@ -9,3 +13,63 @@ def test_timeout_errors_are_retryable() -> None:

 def test_value_errors_are_not_retryable() -> None:
     assert should_retry_rotation(ValueError("bad token")) is False
+
+
+# --- rotate_token tests (AC: retry within 30 s window) ---
+
+
+class _SucceedsAfterN:
+    """Fake client that raises TimeoutError n times then succeeds."""
+
+    def __init__(self, fail_count: int, result: str = "new-token") -> None:
+        self._remaining = fail_count
+        self._result = result
+
+    def rotate(self, token: str) -> str:
+        if self._remaining > 0:
+            self._remaining -= 1
+            raise TimeoutError("upstream slow")
+        return self._result
+
+
+def test_rotate_token_retries_on_timeout() -> None:
+    """Retry on TimeoutError and return the token when rotation succeeds."""
+    client = _SucceedsAfterN(fail_count=2, result="rotated")
+    assert rotate_token(client, "old-token") == "rotated"
+
+
+def test_rotate_token_raises_after_deadline(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Raise TokenRotationError once the 30-second window is exhausted."""
+    calls: list[float] = []
+    real_monotonic = time.monotonic
+
+    def fake_monotonic() -> float:
+        t = real_monotonic()
+        calls.append(t)
+        # After the first call (deadline setup) advance time past the window.
+        return t if len(calls) <= 1 else t + 31
+
+    monkeypatch.setattr(time, "monotonic", fake_monotonic)
+
+    class _AlwaysTimeout:
+        def rotate(self, token: str) -> str:
+            raise TimeoutError("always slow")
+
+    with pytest.raises(TokenRotationError):
+        rotate_token(_AlwaysTimeout(), "old-token")
+
+
+def test_rotate_token_does_not_retry_permanent_failures() -> None:
+    """ValueError (validation failure) must propagate immediately, not be hidden."""
+    call_count = 0
+
+    class _AlwaysInvalid:
+        def rotate(self, token: str) -> str:
+            nonlocal call_count
+            call_count += 1
+            raise ValueError("bad token format")
+
+    with pytest.raises(ValueError, match="bad token format"):
+        rotate_token(_AlwaysInvalid(), "old-token")
+
+    assert call_count == 1, "should not retry on permanent validation failure"
