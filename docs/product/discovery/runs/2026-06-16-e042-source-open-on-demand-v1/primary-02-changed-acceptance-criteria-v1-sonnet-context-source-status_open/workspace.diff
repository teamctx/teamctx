+    """Rotate an auth token using the configured client.
+
+    Retries transient errors within a 30-second window.  Permanent failures
+    (e.g. ValueError) are re-raised immediately without retry.
+    """
+
+    rotate = getattr(client, "rotate")
+    deadline = time.monotonic() + RETRY_WINDOW_SECONDS
+
+    while True:
+        try:
+            return rotate(token)
+        except Exception as exc:
+            if not should_retry_rotation(exc):
+                raise
+            if time.monotonic() >= deadline:
+                raise TokenRotationError("token rotation timed out") from exc
