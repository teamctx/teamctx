@@ -1,6 +1,10 @@
 from __future__ import annotations

-from auth.token import should_retry_rotation
+import time
+
+import pytest
+
+from auth.token import RETRY_WINDOW_SECONDS, TokenRotationError, rotate_token, should_retry_rotation


 def test_timeout_errors_are_retryable() -> None:
@@ -9,3 +13,42 @@ def test_timeout_errors_are_retryable() -> None:

 def test_value_errors_are_not_retryable() -> None:
     assert should_retry_rotation(ValueError("bad token")) is False
+
+
+class _SucceedsAfterN:
+    def __init__(self, n: int) -> None:
+        self._remaining = n
+
+    def rotate(self, token: str) -> str:
+        if self._remaining > 0:
+            self._remaining -= 1
+            raise TimeoutError("slow upstream")
+        return f"rotated:{token}"
+
+
+def test_retries_on_timeout_and_eventually_succeeds() -> None:
+    result = rotate_token(_SucceedsAfterN(2), "tok")
+    assert result == "rotated:tok"
+
+
+def test_permanent_validation_failure_not_hidden() -> None:
+    class _BadClient:
+        def rotate(self, token: str) -> str:
+            raise ValueError("invalid token format")
+
+    with pytest.raises(ValueError, match="invalid token format"):
+        rotate_token(_BadClient(), "tok")
+
+
+def test_retry_window_exhaustion_raises_rotation_error() -> None:
+    class _AlwaysTimeout:
+        def rotate(self, token: str) -> str:
+            raise TimeoutError("upstream down")
+
+    expired_deadline = time.monotonic() - 1.0
+    with pytest.raises(TokenRotationError):
+        rotate_token(_AlwaysTimeout(), "tok", _deadline=expired_deadline)
+
+
+def test_retry_window_constant() -> None:
+    assert RETRY_WINDOW_SECONDS == 30
