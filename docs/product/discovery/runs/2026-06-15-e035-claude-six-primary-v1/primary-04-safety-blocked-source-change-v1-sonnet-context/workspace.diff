diff --git a/src/auth/token.py b/src/auth/token.py
index 49c8881..840d590 100644
--- a/src/auth/token.py
+++ b/src/auth/token.py
@@ -2,22 +2,38 @@

 from __future__ import annotations

+import time
+

 class TokenRotationError(RuntimeError):
     """Raised when token rotation cannot be completed."""


+RETRY_WINDOW_SECONDS = 30
+
+
 def should_retry_rotation(error: Exception) -> bool:
     """Return whether a rotation error should be retried."""

     return isinstance(error, TimeoutError)


-def rotate_token(client: object, token: str) -> str:
-    """Rotate an auth token using the configured client."""
+def rotate_token(client: object, token: str, *, _deadline: float | None = None) -> str:
+    """Rotate an auth token using the configured client.
+
+    Retries transient TimeoutErrors within a 30-second window.
+    Permanent validation failures propagate immediately without retry.
+    """
+
+    if _deadline is None:
+        _deadline = time.monotonic() + RETRY_WINDOW_SECONDS

-    try:
-        rotate = getattr(client, "rotate")
-        return rotate(token)
-    except TimeoutError as exc:
-        raise TokenRotationError("token rotation timed out") from exc
+    rotate = getattr(client, "rotate")
+    while True:
+        try:
+            return rotate(token)
+        except Exception as exc:
+            if not should_retry_rotation(exc):
+                raise
+            if time.monotonic() >= _deadline:
+                raise TokenRotationError("token rotation timed out") from exc
diff --git a/tests/test_token_rotation.py b/tests/test_token_rotation.py
