+
+def rotate_token_with_retry(
+    client: object,
+    token: str,
+    *,
+    retry_window: float = RETRY_WINDOW_SECONDS,
+) -> str:
+    """Rotate a token, retrying transient errors within *retry_window* seconds.
+
+    Permanent failures (e.g. ValueError) are re-raised immediately so they are
+    not hidden behind repeated attempts.
+    """
+
+    deadline = time.monotonic() + retry_window
+    last_exc: Exception | None = None
+
+    while True:
+        try:
+            return rotate_token(client, token)
+        except TokenRotationError as exc:
+            cause = exc.__cause__
+            if cause is not None and not should_retry_rotation(cause):
+                raise
+            last_exc = exc
+
+        if time.monotonic() >= deadline:
+            raise TokenRotationError(
+                f"token rotation failed after {retry_window}s retry window"
+            ) from last_exc
