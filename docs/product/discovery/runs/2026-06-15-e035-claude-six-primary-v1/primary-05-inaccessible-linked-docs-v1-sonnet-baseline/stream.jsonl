{"message": {"content": [{"content": "1\t\"\"\"Token rotation helpers for the benchmark auth service.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\t\n6\tclass TokenRotationError(RuntimeError):\n7\t    \"\"\"Raised when token rotation cannot be completed.\"\"\"\n8\t\n9\t\n10\tdef should_retry_rotation(error: Exception) -> bool:\n11\t    \"\"\"Return whether a rotation error should be retried.\"\"\"\n12\t\n13\t    return isinstance(error, TimeoutError)\n14\t\n15\t\n16\tdef rotate_token(client: object, token: str) -> str:\n17\t    \"\"\"Rotate an auth token using the configured client.\"\"\"\n18\t\n19\t    try:\n20\t        rotate = getattr(client, \"rotate\")\n21\t        return rotate(token)\n22\t    except TimeoutError as exc:\n23\t        raise TokenRotationError(\"token rotation timed out\") from exc\n24\t", "tool_use_id": "toolu_01XAGMZhmg6bXcmydYrksztv", "type": "tool_result"}], "role": "user"}, "parent_tool_use_id": null, "session_id": "ef113a98-4a98-48ab-8f6f-f4210c7cae5c", "timestamp": "2026-06-15T14:48:00.161Z", "tool_use_result": {"file": {"content": "\"\"\"Token rotation helpers for the benchmark auth service.\"\"\"\n\nfrom __future__ import annotations\n\n\nclass TokenRotationError(RuntimeError):\n    \"\"\"Raised when token rotation cannot be completed.\"\"\"\n\n\ndef should_retry_rotation(error: Exception) -> bool:\n    \"\"\"Return whether a rotation error should be retried.\"\"\"\n\n    return isinstance(error, TimeoutError)\n\n\ndef rotate_token(client: object, token: str) -> str:\n    \"\"\"Rotate an auth token using the configured client.\"\"\"\n\n    try:\n        rotate = getattr(client, \"rotate\")\n        return rotate(token)\n    except TimeoutError as exc:\n        raise TokenRotationError(\"token rotation timed out\") from exc\n", "filePath": "/tmp/teamctx-primary-05-inaccessible-linked-docs-v1-ou_0kl8r/workspace/src/auth/token.py", "numLines": 24, "startLine": 1, "totalLines": 24}, "type": "text"}, "type": "user", "uuid": "e77