 from __future__ import annotations

+import time
+

 class TokenRotationError(RuntimeError):
     """Raised when token rotation cannot be completed."""
@@ -13,11 +15,26 @@ def should_retry_rotation(error: Exception) -> bool:
     return isinstance(error, TimeoutError)


+_RETRY_WINDOW_SECONDS = 30
+
+
 def rotate_token(client: object, token: str) -> str:
-    """Rotate an auth token using the configured client."""
+    """Rotate an auth token using the configured client.
+
+    Retries transient failures within a 30-second window.  Permanent
+    validation failures are re-raised immediately so callers are not misled.
+    """
+
+    rotate = getattr(client, "rotate")
+    deadline = time.monotonic() + _RETRY_WINDOW_SECONDS
+    last_exc: Exception | None = None
+
+    while time.monotonic() < deadline:
+        try:
+            return rotate(token)
+        except Exception as exc:
+            if not should_retry_rotation(exc):
+                raise
+            last_exc = exc

-    try:
-        rotate = getattr(client, "rotate")
-        return rotate(token)
-    except TimeoutError as exc:
-        raise TokenRotationError("token rotation timed out") from exc
+    raise TokenRotationError("token rotation timed out") from last_exc
