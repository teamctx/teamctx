 from __future__ import annotations

-from auth.token import should_retry_rotation
+import time
+
+import pytest
+
+from auth.token import TokenRotationError, _RETRY_WINDOW_SECONDS, rotate_token, should_retry_rotation


 def test_timeout_errors_are_retryable() -> None:
@@ -9,3 +13,74 @@ def test_timeout_errors_are_retryable() -> None:

 def test_value_errors_are_not_retryable() -> None:
     assert should_retry_rotation(ValueError("bad token")) is False
+
+
+def test_rotate_token_success() -> None:
+    class GoodClient:
+        def rotate(self, token: str) -> str:
+            return "new-" + token
+
+    assert rotate_token(GoodClient(), "abc") == "new-abc"
+
+
+def test_permanent_failure_is_not_hidden() -> None:
+    """ValueError (invalid token) must propagate immediately, not be swallowed."""
+
+    class BadClient:
+        def rotate(self, token: str) -> str:
+            raise ValueError("bad token format")
+
+    with pytest.raises(ValueError, match="bad token format"):
+        rotate_token(BadClient(), "abc")
+
+
+def test_retry_succeeds_after_transient_timeout() -> None:
+    """rotate_token retries on TimeoutError and returns on eventual success."""
+
+    calls: list[int] = []
+
+    class FlakyClient:
+        def rotate(self, token: str) -> str:
+            calls.append(1)
+            if len(calls) < 3:
+                raise TimeoutError("upstream slow")
+            return "rotated-" + token
+
+    result = rotate_token(FlakyClient(), "tok")
+    assert result == "rotated-tok"
+    assert len(calls) == 3
+
+
+def test_retry_window_is_30_seconds() -> None:
+    assert _RETRY_WINDOW_SECONDS == 30
+
+
+def test_exhausted_retry_window_raises_token_rotation_error() -> None:
+    """When every attempt times out, TokenRotationError is raised after the window."""
+
+    call_count = 0
+
+    class AlwaysTimeoutClient:
+        def rotate(self, token: str) -> str:
+            nonlocal call_count
+            call_count += 1
+            raise TimeoutError("still slow")
+
+    # Patch time so the window appears expired after the first call.
+    original_monotonic = time.monotonic
+    tick = [original_monotonic()]
+
+    def fake_monotonic() -> float:
+        # First call returns start time; subsequent calls return start + 31.
+        v = tick[0]
+        tick[0] += 31
+        return v
+
+    import auth.token as token_module
+
+    token_module.time = type("_FakeTime", (), {"monotonic": staticmethod(fake_monotonic)})()  # type: ignore[assignment]
+    try:
+        with pytest.raises(TokenRotationError):
+            rotate_token(AlwaysTimeoutClient(), "tok")
+    finally:
+        token_module.time = time  # type: ignore[assignment]
