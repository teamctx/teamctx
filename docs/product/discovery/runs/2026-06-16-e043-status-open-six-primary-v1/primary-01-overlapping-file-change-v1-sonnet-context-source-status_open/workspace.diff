+def rotate_token(client: object, token: str, max_retries: int = _DEFAULT_MAX_RETRIES) -> str:
+    """Rotate an auth token using the configured client, retrying on transient errors."""
+
+    rotate = getattr(client, "rotate")
+    last_exc: Exception | None = None
+    for attempt in range(max_retries + 1):
+        try:
+            return rotate(token)
+        except Exception as exc:
+            if should_retry_rotation(exc) and attempt < max_retries:
+                last_exc = exc
+                continue
+            raise TokenRotationError("token rotation failed") from exc
+    raise TokenRotationError("token rotation failed after retries") from last_exc
