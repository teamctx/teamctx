index 49c8881..5b619f0 100644
--- a/src/auth/token.py
+++ b/src/auth/token.py
@@ -2,6 +2,10 @@

 from __future__ import annotations

+import time
+
+RETRY_WINDOW_SECONDS = 30
+

 class TokenRotationError(RuntimeError):
     """Raised when token rotation cannot be completed."""
@@ -21,3 +25,22 @@ def rotate_token(client: object, token: str) -> str:
         return rotate(token)
     except TimeoutError as exc:
         raise TokenRotationError("token rotation timed out") from exc
+
+
+def rotate_token_with_retry(client: object, token: str) -> str:
+    """Rotate an auth token, retrying transient failures within a 30-second window.
+
+    Permanent validation failures propagate immediately without retry.
+    """
+    deadline = time.monotonic() + RETRY_WINDOW_SECONDS
+    last_error: TokenRotationError | None = None
+
+    while time.monotonic() < deadline:
+        try:
+            return rotate_token(client, token)
+        except TokenRotationError as exc:
+            if exc.__cause__ is None or not should_retry_rotation(exc.__cause__):
+                raise
+            last_error = exc
+
+    raise TokenRotationError("token rotation failed within retry window") from last_error
diff --git a/tests/test_token_rotation.py b/tests/test_token_rotation.py
index 14ff4c3..e5d4086 100644
--- a/tests/test_token_rotation.py
+++ b/tests/test_token_rotation.py
@@ -1,6 +1,10 @@
 from __future__ import annotations

-from auth.token import should_retry_rotation
+import time
+
+import pytest
+
+from auth.token import TokenRotationError, should_retry_rotation, rotate_token_with_retry


 def test_timeout_errors_are_retryable() -> None:
@@ -9,3 +13,39 @@ def test_timeout_errors_are_retryable() -> None:

 def test_value_errors_are_not_retryable() -> None:
     assert should_retry_rotation(ValueError("bad token")) is False
+
+
+def test_permanent_failures_are_not_retried() -> None:
+    """Non-retryable errors must propagate immediately without retry (AC #3)."""
+    call_count = 0
+
+    class BadFormatClient:
+        def rotate(self, token: str) -> str:
+            nonlocal call_count
+            call_count += 1
+            raise ValueError("invalid token format")
+
+    with pytest.raises(ValueError):
+        rotate_token_with_retry(BadFormatClient(), "tok")
+
+    assert call_count == 1
+
+
+def test_retry_stops_after_30_second_window(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Retry loop must exit once the 30-second window is exhausted (AC #1)."""
+    # deadline = times[0] + 30 = 30.0; second check times[2] = 31.0 → exits
+    fake_times = iter([0.0, 0.1, 31.0])
+    monkeypatch.setattr(time, "monotonic", lambda: next(fake_times))
+
+    call_count = 0
+
+    class AlwaysTimesOut:
+        def rotate(self, token: str) -> str:
+            nonlocal call_count
+            call_count += 1
+            raise TimeoutError("slow upstream")
+
+    with pytest.raises(TokenRotationError):
+        rotate_token_with_retry(AlwaysTimesOut(), "tok")
+
+    assert call_count == 1  # tried once before window expired
