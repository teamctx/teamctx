{"message": {"content": [{"content": "1\t\"\"\"Token rotation helpers for the benchmark auth service.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\t\n6\tclass TokenRotationError(RuntimeError):\n7\t    \"\"\"Raised when token rotation cannot be completed.\"\"\"\n8\t\n9\t\n10\tdef should_retry_rotation(error: Exception) -> bool:\n11\t    \"\"\"Return whether a rotation error should be retried.\"\"\"\n12\t\n13\t    return isinstance(error, TimeoutError)\n14\t\n15\t\n16\tdef rotate_token(client: object, token: str) -> str:\n17\t    \"\"\"Rotate an auth token using the configured client.\"\"\"\n18\t\n19\t    try:\n20\t        rotate = getattr(client, \"rotate\")\n21\t        return rotate(token)\n22\t    except TimeoutError as exc:\n23\t        raise TokenRotationError(\"token rotation timed out\") from exc\n24\t", "tool_use_id": "toolu_01JV8oCzmAbiqq5V5dvWYKeM", "type": "tool_result"}], "role": "user"}, "parent_tool_use_id": null, "session_id": "325aed8a-bcb8-4119-be19-795e98a16b38", "timestamp": "2026-06-16T18:19:54.154Z", "tool_use_result": {"file": {"content": "\"\"\"Token rotation helpers for the benchmark auth service.\"\"\"\n\nfrom __future__ import annotations\n\n\nclass TokenRotationError(RuntimeError):\n    \"\"\"Raised when token rotation cannot be completed.\"\"\"\n\n\ndef should_retry_rotation(error: Exception) -> bool:\n    \"\"\"Return whether a rotation error should be retried.\"\"\"\n\n    return isinstance(error, TimeoutError)\n\n\ndef rotate_token(client: object, token: str) -> str:\n    \"\"\"Rotate an auth token using the configured client.\"\"\"\n\n    try:\n        rotate = getattr(client, \"rotate\")\n        return rotate(token)\n    except TimeoutError as exc:\n        raise TokenRotationError(\"token rotation timed out\") from exc\n", "filePath": "/tmp/teamctx-primary-03-stale-process-doc-v1-u7wl0c_r/workspace/src/auth/token.py", "numLines": 24, "startLine": 1, "totalLines": 24}, "type": "text"}, "type": "user", "uuid": "57637dad-c