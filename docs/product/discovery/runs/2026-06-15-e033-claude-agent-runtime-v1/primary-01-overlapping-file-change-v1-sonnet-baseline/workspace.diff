+
+def rotate_token_with_retry(
+    client: object,
+    token: str,
+    *,
+    retry_window: float = 30.0,
+) -> str:
+    """Rotate a token, retrying transient failures within *retry_window* seconds.
+
+    Permanent errors (e.g. ValueError for bad tokens) are raised immediately
+    without retrying so they are never hidden from callers.
+    """
+
+    deadline = time.monotonic() + retry_window
+    last_exc: Exception | None = None
+
+    while True:
+        try:
+            return rotate_token(client, token)
+        except TokenRotationError as exc:
+            cause = exc.__cause__
+            if cause is None or not should_retry_rotation(cause):
+                raise
+            last_exc = exc
+        except Exception:
+            raise
+
+        if time.monotonic() >= deadline:
+            break
+
+    raise TokenRotationError("token rotation failed: retry window exhausted") from last_exc
